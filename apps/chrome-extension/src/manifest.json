{
  "manifest_version": 3,
  "name": "Nexos",
  "version": "0.1.0",
  "description": "Deixa o agente do Nexos usar este Chrome — só nas abas do grupo \"Nexos\" que ele mesmo abrir.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "scripting", "debugger", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Nexos",
    "default_popup": "popup.html",
    "default_icon": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png" }
  },
  "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" }
}
