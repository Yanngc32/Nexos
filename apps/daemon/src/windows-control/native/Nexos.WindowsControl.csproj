<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Nexos.WindowsControl</AssemblyName>
    <RootNamespace>Nexos.WindowsControl</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Captura de janela (WindowCapture.cs, System.Drawing.Bitmap) — o daemon
         não roda dentro do Electron, então não tem desktopCapturer; a captura
         via PrintWindow precisa de GDI+ gerenciado. -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" />
  </ItemGroup>
</Project>
